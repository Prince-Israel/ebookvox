{
  "name": "ebookvox-reader",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3230",
    "build": "prisma generate && next build",
    "start": "next start -p 3230",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "icons": "tsx scripts/make-icons.ts",
    "test:api": "tsx tests/api.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "bash tests/run.sh api",
    "test:ui": "bash tests/run.sh ui",
    "mobile:sync": "cap sync",
    "mobile:android": "cap sync android && cap open android",
    "mobile:ios": "cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.56.0",
    "mammoth": "^1.13.0",
    "msedge-tts": "^2.0.9",
    "next": "^15.5.27",
    "nodemailer": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "docx": "^9.10.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.0",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
