DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3240"
ADMIN_EMAIL="admin@publisher.ebookvox.app"
ADMIN_PASSWORD="change-me"
# Reader platform (server-to-server)
READER_URL="http://localhost:3230"
PUBLISHER_API_KEY="dev-publisher-key-change-me"
# Shared secret used to sign events sent by the Reader to this app (must equal Reader's PUBLISHER_WEBHOOK_SECRET)
READER_WEBHOOK_SECRET="dev-webhook-secret-change-me"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Ebookvox Publisher <no-reply@ebookvox.app>"
PUBLISHER_ADMIN_SECRET="change-me-to-a-long-random-secret"

# Local preview only (never in production): auto-verify new accounts when SMTP_HOST is empty.
DEV_AUTO_VERIFY="false"
