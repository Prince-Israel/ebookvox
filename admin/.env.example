DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3250"
# First Super Admin (created by `npm run db:setup`)
ADMIN_EMAIL="superadmin@ebookvox.app"
ADMIN_PASSWORD="change-me"
# Services (server-to-server, HMAC-signed). Secrets must match the other platforms' *_ADMIN_SECRET.
READER_URL="http://localhost:3230"
READER_ADMIN_SECRET="change-me-to-a-long-random-secret"
PUBLISHER_URL="http://localhost:3240"
PUBLISHER_ADMIN_SECRET="change-me-to-a-long-random-secret"
