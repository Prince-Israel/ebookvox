# /etc/nginx/sites-available/ebookvox  — replace example.com with your domain, then:
#   sudo ln -s /etc/nginx/sites-available/ebookvox /etc/nginx/sites-enabled/ && sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d app.example.com -d publisher.example.com -d admin.example.com   (adds HTTPS + auto-renew)
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
  server_name app.example.com;                       # Reader (web + the mobile apps' backend)
  location / { proxy_pass http://127.0.0.1:3230; include /etc/nginx/ebookvox-proxy.conf; }
}
server {
  server_name publisher.example.com;                 # Publisher
  client_max_body_size 80m;                          # book uploads (PDF/DOCX/TXT) + covers
  location / { proxy_pass http://127.0.0.1:3240; include /etc/nginx/ebookvox-proxy.conf; }
}
server {
  server_name admin.example.com;                     # Admin (consider restricting by IP: allow x.x.x.x; deny all;)
  location / { proxy_pass http://127.0.0.1:3250; include /etc/nginx/ebookvox-proxy.conf; }
}

# --- /etc/nginx/ebookvox-proxy.conf (create this file with the lines below) ---
# proxy_http_version 1.1;
# proxy_set_header Host $host;
# proxy_set_header X-Real-IP $remote_addr;
# proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# proxy_set_header X-Forwarded-Proto $scheme;
# proxy_set_header Upgrade $http_upgrade;
# proxy_set_header Connection $connection_upgrade;
# proxy_read_timeout 120s;
