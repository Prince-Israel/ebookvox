DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3230"
# Seeded administrator (used by `npm run db:seed`)
ADMIN_EMAIL="admin@ebookvox.app"
ADMIN_PASSWORD="change-me"
# Shared secret for the Publisher platform -> Reader ingestion API
PUBLISHER_API_KEY="dev-publisher-key-change-me"
# Paystack (server-side only!)
PAYSTACK_SECRET_KEY=""
PAYSTACK_BASE_URL="https://api.paystack.co"
# Text to speech: "auto" (Azure when configured), "azure", "edge", or "say" (macOS dev only)
TTS_PROVIDER="auto"
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
# Social login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
# Email (SMTP). When empty, emails are written to the EmailLog table only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Ebookvox <no-reply@ebookvox.app>"

# Publisher platform integration (events: sales, book decisions)
PUBLISHER_WEBHOOK_URL="http://localhost:3240/api/webhooks/reader"
PUBLISHER_WEBHOOK_SECRET="dev-webhook-secret-change-me"
READER_ADMIN_SECRET="change-me-to-a-long-random-secret"

# Local preview only (never in production): auto-verify new accounts when SMTP_HOST is empty.
DEV_AUTO_VERIFY="false"

# ---- Public links & ads (read at start-up; shown to visitors) ----
# Where authors/publishers register (the Publisher site). The Reader's "Publish your books" buttons open <this>/sign-up.
PUBLISHER_PUBLIC_URL="http://localhost:3240"
# Store listings for the "Get the app" badges. Leave empty until the apps are published (the Android badge then offers the APK).
PLAY_STORE_URL=""
APP_STORE_URL=""
APK_DOWNLOAD_URL=""
# Google AdSense for the website (see docs/ADS.md). ADSENSE_CLIENT looks like ca-pub-1234567890123456
ADSENSE_CLIENT=""
ADSENSE_SLOT_HOME=""
ADSENSE_SLOT_BOOKS=""

# Weekly reader email ("continue where you stopped" + new books). A long random value; call POST /api/cron/digest with header x-cron-secret from a cron job.
CRON_SECRET=""
ADMOB_ANDROID_REWARDED_ID=""
ADMOB_IOS_REWARDED_ID=""

# Search engines: paste the verification codes from Google Search Console / Bing Webmaster Tools (optional)
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# API.Bible key (https://scripture.api.bible) — switches on NIV, AMP and MSG in the Bible
BIBLE_API_KEY=""

# YouVersion Platform app key (https://platform.youversion.com) — BSB, WEB and, once licensed, TPT in the Bible
YOUVERSION_APP_KEY=""
